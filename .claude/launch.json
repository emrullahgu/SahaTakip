{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Expo Dev Server (Metro)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 8081
    },
    {
      "name": "Expo Web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web"],
      "port": 8081
    },
    {
      "name": "Serve Web Build (dist)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "serve:web"],
      "port": 3000
    }
  ]
}
