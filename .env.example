# =============================================================
# SahaTakip — Ortam Değişkenleri
# =============================================================
# Bu dosyayı `.env` olarak kopyala ve değerleri gir.
# Sadece EXPO_PUBLIC_* prefix'li değişkenler client'a sızar.
# =============================================================

# Supabase (https://app.supabase.com → Proje → Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Google Maps (Android için)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR-MAPS-KEY

# Auth redirect (e-posta onay / şifre sıfırlama linkleri bu adrese döner).
# Production canonical URL — localhost veya preview'dan signup yapılsa bile
# onay maili buraya yönlendirilir. Örn: https://sahatakip.netlify.app
# Supabase Dashboard → Auth → URL Configuration → Redirect URLs listesine de
# `${EXPO_PUBLIC_SITE_URL}/auth-callback` mutlaka eklenmeli.
EXPO_PUBLIC_SITE_URL=https://YOUR-SITE.netlify.app

# İleride (POZ-DEV-074/075/076 — sunucu tarafı, Edge Function)
# RESEND_API_KEY=
# NETGSM_USER=
# NETGSM_PASS=

# =============================================================
# AI / Otonom Ajan
# =============================================================
# LLM provider anahtarları (en az biri gerekli — Groq önerilir, ücretsiz katman).
# EXPO_PUBLIC_GROQ_KEY=gsk_...
# EXPO_PUBLIC_OPENAI_KEY=sk-...
# EXPO_PUBLIC_CLAUDE_KEY=
# EXPO_PUBLIC_GEMINI_KEY=
EXPO_PUBLIC_AI_DEFAULT_PROVIDER=groq

# GÜVENLİK (önerilen): Anahtarları cihaza gömmek yerine sunucu-tarafı proxy kullan.
# true yapıldığında metin AI çağrıları supabase/functions/ai-proxy üzerinden gider;
# istemciye API anahtarı GEREKMEZ (yukarıdaki EXPO_PUBLIC_*_KEY'ler boş bırakılabilir).
# ÖN KOŞUL: `supabase functions deploy ai-proxy` + proxy ortamında OPENAI_API_KEY /
# ANTHROPIC_API_KEY / GEMINI_API_KEY tanımlı olmalı. (Görsel/PDF ve Agent şu an yalnız
# doğrudan-anahtar modunda çalışır; proxy yalnız metni destekler.)
# EXPO_PUBLIC_AI_USE_PROXY=true

# Web arama (Otonom Ajan için — en az biri gerekli; aksi halde web_search devre dışı).
# Tavily önerilir: https://tavily.com (ücretsiz katman 1000/ay).
# EXPO_PUBLIC_TAVILY_KEY=tvly-...
# EXPO_PUBLIC_SERPER_KEY=
# EXPO_PUBLIC_BRAVE_SEARCH_KEY=

# =============================================================
# Entegrasyonlar (roadmap — şu an stub)
# =============================================================
# Gmail (Google Cloud Console → OAuth 2.0 + Gmail API)
# EXPO_PUBLIC_GMAIL_CLIENT_ID=
# WhatsApp Cloud API (Meta for Developers)
# EXPO_PUBLIC_WHATSAPP_PHONE_ID=
# EXPO_PUBLIC_WHATSAPP_TOKEN=
# Paraşüt (https://apidocs.parasut.com)
# EXPO_PUBLIC_PARASUT_CLIENT_ID=
# EXPO_PUBLIC_PARASUT_CLIENT_SECRET=
# EXPO_PUBLIC_PARASUT_COMPANY_ID=
# Google Drive (Google Cloud Console → Drive API + OAuth)
# EXPO_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=

# Google Maps (Android native build için; app.config.js bunu otomatik enjekte eder)
# GOOGLE_MAPS_API_KEY=
